# Names only, never values. This file is committed on purpose; .env is ignored.
#
# These are the *bootstrap* layer — the credentials the stack needs before anything is
# running. D33 rules that operational credentials for the pipeline (the CWA open-data key,
# and the pipeline's own database access) become Airflow Connections, encrypted in Airflow's
# metadata database, and never appear here. The API's database URL is assembled from these
# by compose, because the API cannot read an Airflow Connection.
# shape: any identifier · any identifier · any string, generate one
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# A15 / D115 — the four service roles. `POSTGRES_USER` above stays the **owner**: it runs Alembic,
# it owns every table, and **no service connects as it**. These four are what the running product
# actually uses, each holding one boundary the record already draws:
#   upto_api      the API — the product's tables, read-only on everything the pipeline publishes
#   upto_ingest   the DAGs, the classifier, the seed CLIs — and NOTHING that names a person
#   upto_lineage  the MCP lineage tool — SELECT on exactly the tables it declares
#   upto_erasure  the nightly preference erasure — SELECT/DELETE on `preference` and almost nothing
# The roles are created by the init service from these values, and the GRANTs are revision 0032.
# Rotating one is this file, then `docker compose up airflow-init --force-recreate --no-deps`.
# shape: any string, generate one
UPTO_API_DB_PASSWORD=
# shape: any string, generate one
UPTO_INGEST_DB_PASSWORD=
# shape: any string, generate one
UPTO_LINEAGE_DB_PASSWORD=
# shape: any string, generate one
UPTO_ERASURE_DB_PASSWORD=
# shape: any string, generate one. A22's nightly `pg_dump` (revision 0038). It holds
# `pg_read_all_data` and no write anywhere, so it cannot change the database — but it CAN read
# every `preference` row, so treat it like the other four and not like a read-only afterthought.
UPTO_BACKUP_DB_PASSWORD=

# A22 — where the nightly dump goes. **Leave all four empty and the backup DAG skips cleanly**:
# no bucket means no destination, the first task raises `AirflowSkipException` and the sweep skips
# with it. That is the designed state for a fresh clone, for `split_boot_check.sh` and for CI — a
# stack with no AWS account boots green rather than red (A10's shape).
# shape: an S3 bucket name, in the Tokyo region (D61). Created by hand by the account owner.
UPTO_BACKUP_S3_BUCKET=
# shape: a key prefix with no leading or trailing slash; `db` when unset.
UPTO_BACKUP_S3_PREFIX=
# shape: the scoped IAM key's id and secret (D61's `upto-deploy`). Read by the init service ONCE,
# to create the `upto_backup_s3` Connection; no task reads them from here afterwards (D33/H16).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# shape: a TCP port number. The one port the product is published on; 8080 when unset.
UPTO_HTTP_PORT=

# shape: an origin a member's browser can reach — scheme and host, no path. A20/D74: the address
# `python -m upto.issue` builds its invite link on. **Leave it empty and it works** —
# `upto/issue.py` defaults to the proxy's own `http://localhost:8080`, so a fresh clone prints a
# working link with no configuration. Set it when the stack is reachable at a real hostname; a link
# built on `localhost` is one nobody else can open.
UPTO_PUBLIC_ORIGIN=

# Airflow's own bootstrap layer, and this is the whole of it (D33). Everything the DAGs
# use — the CWA key, the application database — is an Airflow Connection instead, created
# once by the init service and stored Fernet-encrypted in Airflow's metadata database.
# shape: any string, generate one
AIRFLOW_DB_PASSWORD=
# shape: 32 random bytes, url-safe base64 — Airflow refuses to start on anything else.
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AIRFLOW_FERNET_KEY=
# shape: any string, generate one
AIRFLOW_ADMIN_PASSWORD=
# Signs the tokens workers present to the Execution API. Every Airflow container must
# share it, or a task fails with "Invalid auth token: Signature verification failed".
# shape: any long string; every Airflow container must share this one value
AIRFLOW_JWT_SECRET=
# shape: CWA- followed by an uppercase-hex UUID, 40 characters. Read once at init to create
# the Connection, and never read by a task afterwards.
UPTO_CWA_API_KEY=

# A10's failure alerts, and **both may be left empty**: with either one blank the
# `telegram_alerts` Connection is not created and failed tasks alert nowhere, which is the
# designed state for a stack nobody is watching (a fresh clone, `tools/split_boot_check.sh`).
# Read once at init to create the Connection, and never read by a task afterwards.
# shape: digits, a colon, then 35 url-safe characters — what @BotFather prints once
UPTO_TELEGRAM_BOT_TOKEN=
# shape: an integer, negative for a group. Send the bot a message, then read
#   https://api.telegram.org/bot<token>/getUpdates  and take result[].message.chat.id
UPTO_TELEGRAM_CHAT_ID=

# shape: a TCP port number. The orchestrator UI; 8081 when unset.
AIRFLOW_HTTP_PORT=
