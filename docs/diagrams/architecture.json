  "cards": [
    {
      "dot": "cyan",
      "title": "One host, one compose file",
      "items": [
        "Every box inside the cloud boundary is a container on one EC2 instance",
        "The schema is applied once per deploy, and an instance refuses a schema it was not written against"
      ]
    },
    {
      "dot": "emerald",
      "title": "Roles, not one superuser",
      "items": [
        "Six logins, one per boundary — and the owner is held only by the one-shot migration container",
        "The backup role can read everything and write nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "Off the host",
      "items": [
        "The model runs at home and is reached through a user-level tunnel, not a container",
        "Backups keep thirty nightly dumps, swept only after a successful upload"
      ]
    }
  ]
