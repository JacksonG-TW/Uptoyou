  "cards": [
    {
      "dot": "cyan",
      "title": "Serving over HTTPS — since 2026-09-07",
      "items": [
        "https://uptoyou.jacksong-tw.com — Cloudflare Full (strict) to an Origin CA cert on nginx",
        "The security group admits 443 from Cloudflare's ranges only; 80 is closed; the host holds an Elastic IP",
        "TLS is a mounted file, not a build — compose defaults to :8443, so a fresh clone needs no privileged port"
      ]
    },
    {
      "dot": "emerald",
      "title": "Roles, not one superuser",
      "items": [
        "migrate runs as the owner and exits; api never can",
        "upto_api · upto_ingest · upto_erasure · upto_backup",
        "the api exits rather than serve a schema it was not written against"
      ]
    },
    {
      "dot": "rose",
      "title": "Off the host",
      "items": [
        "The GPU box is reached through a user-level relay, not a container",
        "S3 Tokyo keeps 30 nightly dumps, swept only after a successful upload",
        "ollama sits behind a compose profile and is off unless a backfill runs"
      ]
    }
  ]
